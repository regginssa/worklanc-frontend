# App URL used for OAuth redirect URIs (no trailing slash)
APP_URL=

# Backend API (browser)
NEXT_PUBLIC_BACKEND_URL=

# Stripe (browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PayPal (browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_PAYPAL_ENVIRONMENT=

# Reown AppKit / WalletConnect (browser)
NEXT_PUBLIC_REOWN_PROJECT_ID=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APPKIT_USE_TESTNETS=

# Optional Solana RPC for wallet payments (defaults to mainnet-beta public RPC)
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Crypto
NEXT_PUBLIC_CHRLE_TOKEN_ADDRESS=
NEXT_PUBLIC_BABYU_TOKEN_ADDRESS=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Shared secret between Next.js OAuth callbacks and Express /api/auth/oauth
# Generate: openssl rand -hex 32
OAUTH_INTERNAL_SECRET=

# Google OAuth (server-only — do not use NEXT_PUBLIC_)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (server-only)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM private key contents (use \n for newlines in .env.local)
APPLE_PRIVATE_KEY=
